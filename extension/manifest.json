{
  "manifest_version": 3,
  "name": "Bulk Manager für ChatGPT",
  "short_name": "Bulk Manager",
  "version": "2.0.0",
  "description": "Chats in ChatGPT durchsuchen, auswählen und gesammelt archivieren, wiederherstellen oder löschen.",
  "homepage_url": "https://github.com/aemjay/bulk-manager-for-chatgpt",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Chats verwalten",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Chat-Verwaltung öffnen/schließen"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
